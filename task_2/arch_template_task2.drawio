          <mxGeometry x="2706" y="5395" width="137" height="87" as="geometry" />
        </mxCell>
        <mxCell id="lSDpJ6RXpZijRyi6GU7y-61" value="" style="group;strokeColor=light-dark(#FF0000,#FFFFFF);" parent="1" vertex="1" connectable="0">
