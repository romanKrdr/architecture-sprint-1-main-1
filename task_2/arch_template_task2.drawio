        <mxCell id="lSDpJ6RXpZijRyi6GU7y-57" value="Запрос на регистрацию" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];strokeColor=light-dark(#FF0000,#FFFFFF);" parent="lSDpJ6RXpZijRyi6GU7y-54" vertex="1" connectable="0">
